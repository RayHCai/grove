{
    "name": "@grove/server-manager",
    "version": "0.0.0",
    "private": true,
    "description": "The fleet load balancer and join router: which box a version deploys to, and which box a joining player is sent to. Go.",
    "scripts": {
        "build": "node ../../../scripts/go.mjs build -o dist/server-manager .",
        "typecheck": "node ../../../scripts/go.mjs vet ./... && node ../../../scripts/staticcheck.mjs ./...",
        "test": "node ../../../scripts/go.mjs test ./...",
        "format": "node ../../../scripts/go.mjs fmt ./...",
        "format:check": "node ../../../scripts/gofmt-check.mjs",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@grove/go-grove": "workspace:*"
    }
}
