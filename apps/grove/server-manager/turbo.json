{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            // The root's inputs are a TypeScript package's, and none of them match a Go tree — an
            // edit to a .go file would never invalidate this task's cache.
            "inputs": ["**/*.go", "go.mod", "go.sum", "package.json"],
            // The binary goes to dist/, but declaring it makes turbo warn on every machine without
            // a Go toolchain, where the task correctly produces nothing at all.
            "outputs": []
        },
        "typecheck": {
            "inputs": ["**/*.go", "go.mod", "go.sum", "package.json"],
            "outputs": []
        },
        "test": {
            "inputs": ["**/*.go", "go.mod", "go.sum", "package.json"],
            "outputs": []
        }
    }
}
