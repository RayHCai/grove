{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "references": [
        {
            "path": "../../../libs/player"
        },
        {
            "path": "../../../libs/ui"
        }
    ]
}
