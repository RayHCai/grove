{
    "name": "@grove/player-app",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The origin a game renders on: one index.html, a React entry point, and the root it mounts.",
    "scripts": {
        "dev": "pnpm --filter @grove/ui build && vite",
        "build": "vite build",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@grove/api-contract": "workspace:*",
        "@grove/player": "workspace:*",
        "@grove/ui": "workspace:*",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^28.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    }
}
