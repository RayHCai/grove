{
    "name": "@grove/game-manager",
    "version": "0.0.0",
    "private": true,
    "description": "Game data for running sessions. The only thing between a game process and its data.",
    "scripts": {
        "build": "node ../../../scripts/go.mjs build -o dist/game-manager .",
        "typecheck": "node ../../../scripts/go.mjs vet ./... && node ../../../scripts/staticcheck.mjs ./...",
        "test": "node ../../../scripts/go.mjs test ./...",
        "format": "node ../../../scripts/go.mjs fmt ./...",
        "format:check": "node ../../../scripts/gofmt-check.mjs",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@grove/go-grove": "workspace:*"
    }
}
