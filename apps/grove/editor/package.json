{
    "name": "@grove/editor",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The game editor: opens a creator's newest game out of object storage, saves it as they type, and compiles and plays it here in the tab.",
    "scripts": {
        "dev": "pnpm --filter @grove/ui build && vite",
        "build": "vite build",
        "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.creator.json",
        "test": "vitest run",
        "clean": "rm -rf dist .turbo",
        "try": "pnpm --filter @grove/ui build && vite --open /try.html"
    },
    "dependencies": {
        "@grove/api-contract": "workspace:*",
        "@grove/player": "workspace:*",
        "@grove/ui": "workspace:*",
        "@platform/core": "workspace:*",
        "@platform/engine": "workspace:*",
        "@platform/math": "workspace:*",
        "@platform/project": "workspace:*",
        "@platform/scripting": "workspace:*",
        "@platform/transport": "workspace:*",
        "monaco-editor": "^0.56.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.0",
        "vitest": "^5.0.1"
    }
}
