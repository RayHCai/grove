{
    "name": "@grove/editor",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The game editor: signs a creator in, opens their game out of object storage, saves and publishes it, and runs it locally in a sandboxed frame.",
    "scripts": {
        "dev": "pnpm --filter @grove/ui build && vite",
        "build": "vite build",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@grove/api-contract": "workspace:*",
        "@grove/ui": "workspace:*",
        "monaco-editor": "^0.56.0",
        "react": "^19.2.8",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^28.0.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    }
}
