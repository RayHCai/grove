{
    // The creator's own program: every file the editor seeds or compiles, checked the way the
    // workbench checks it. No import resolves anything from this app — `src/creator/globals.d.ts`
    // is the whole surface — and the DOM library is deliberately absent, because a game is not a
    // page and two of its names collide with the engine's.
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": [],
        "noEmit": true,
        "composite": false,
        "incremental": false,
        "declaration": false,
        "declarationMap": false
    },
    "include": ["src/creator/**/*.ts"],
    "references": []
}
