{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    // A creator's program is checked on its own, by tsconfig.creator.json: the globals it is
    // written against would otherwise be this app's globals too.
    "exclude": ["src/creator/**"],
    "references": []
}
