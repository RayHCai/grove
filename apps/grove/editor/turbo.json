{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            // index.html is the entry vite builds from, and vite.config.ts with the plugin it loads
            // decide what it emits; none is under src/**, so the root task would cache across them.
            "inputs": [
                "package.json",
                "src/**",
                "tsconfig*.json",
                "vite.config.ts",
                "preview.plugin.ts",
                "index.html",
                "public/**"
            ]
        },
        "dev": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "inputs": ["src/**", "tests/**", "tsconfig*.json", "*.config.ts", "*.plugin.ts"]
        },
        "test": {
            "inputs": ["src/**", "tests/**", "vitest.config.ts", "tsconfig*.json"]
        }
    }
}
