{
    "name": "@grove/instance-manager",
    "version": "0.0.0",
    "private": true,
    "description": "The agent on one EC2 instance: supervises the game processes on this box, reads their health and logs, and reports capacity upward. Go.",
    "scripts": {
        "build": "node ../../../scripts/go.mjs build -o dist/instance-manager .",
        "typecheck": "node ../../../scripts/go.mjs vet ./... && node ../../../scripts/staticcheck.mjs ./...",
        "test": "node ../../../scripts/go.mjs test ./...",
        "format": "node ../../../scripts/go.mjs fmt ./...",
        "format:check": "node ../../../scripts/gofmt-check.mjs",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@grove/go-grove": "workspace:*"
    }
}
