# Copied to .env.local for a build that is not the local stack; a dev server needs none of it.
VITE_API_URL=http://localhost:4000
VITE_EDITOR_URL=http://localhost:5176
VITE_PLAYER_URL=http://localhost:5177
# Shows, in a build, what is drawn but not wired to anything yet; a dev server always does.
VITE_SHOW_UNFINISHED=false
