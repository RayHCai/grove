{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "apps/grove/api/Dockerfile"
    },
    "deploy": {
        "preDeployCommand": ["node node_modules/prisma/build/index.js migrate deploy"],
        "healthcheckPath": "/health",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE",
        "drainingSeconds": 35
    }
}
