DATABASE_URL="postgresql://grove:grove@localhost:5432/grove"
REDIS_URL="redis://localhost:6379"

# The bucket, against the MinIO in compose.yaml. Versioning has to be on for it — a manifest names
# the version of each file, and a bucket without it answers none.
GAMES_BUCKET="grove-games"
S3_ENDPOINT="http://localhost:9000"
AWS_ACCESS_KEY_ID="grove"
AWS_SECRET_ACCESS_KEY="grove-dev-secret"
