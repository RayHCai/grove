# Copy to `.env`, which is gitignored. Everything `src/env.ts` requires is here; `tests/env.test.ts`
# parses this file against that schema, so a variable added to one without the other fails the suite
# rather than a deploy.
#
# These are development values in a file everybody can read, which is the whole point: nothing here
# protects anything. A deployed process is handed its secrets out of band.

NODE_ENV="development"
API_HOST="0.0.0.0"
API_PORT=4000

# The three seams that are absent rather than defaulted: each leaves the routes that need it
# answering for themselves, which is a state this service already has, where a bad value is a
# process that will not start.
DATABASE_URL="postgresql://grove:grove@localhost:5432/grove"
REDIS_URL="redis://localhost:6379"
GAMES_BUCKET="grove-games"

# The bucket, against the LocalStack in the repository root's `compose.yaml`. Versioning has to be on
# for it: a manifest names the version of each file, and a bucket without it answers none.
S3_ENDPOINT="http://localhost:4566"
AWS_REGION="us-east-1"
# Read by the AWS SDK rather than by `src/env.ts`. Any pair reaches LocalStack.
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Where the edge serves the games bucket from. In the repository root's `compose.yaml` that is
# LocalStack itself, path style, because there is no distribution in front of it locally.
GAMES_CDN_URL="http://localhost:4566/grove-games"

# One secret per caller, each at least 32 characters and none shared: the browser session cookie,
# the router (placements and deployments out, fleet reports in), the builders, the asset service.
SESSION_SECRET="dev-session-secret-not-for-anything-real"
SERVER_MANAGER_SECRET="dev-server-manager-secret-not-for-anything"
BUILDER_SECRET="dev-builder-secret-not-for-anything-real!"
ASSET_SERVICE_SECRET="dev-asset-service-secret-not-for-anything"

# The Ed25519 seed join tickets are signed with, as 32 bytes of unpadded base64url; the root
# `.env.example` pairs it with the public half the local fleet box verifies against.
TICKET_SIGNING_KEY="HpaHMgzw7uPuR3dlmZ6LCEfVgw_bPkKlljA125YI0xY"

# Where the fleet router answers a placement.
SERVER_MANAGER_URL="http://localhost:4003"

# A peer not named here writes `X-Forwarded-For` itself, and a limit keyed on that hands one caller
# as many buckets as they care to invent.
TRUSTED_PROXIES="loopback"

# The only two origins that hold a logged-in person. The player origin is deliberately absent: it
# runs creator code and never calls this service.
PLATFORM_ORIGIN="http://localhost:5175"
EDITOR_ORIGIN="http://localhost:5176"
