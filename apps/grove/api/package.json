{
    "name": "@grove/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The public API: accounts, projects, social, and the allocator that mints join tickets.",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/csrf-protection": "^8.0.1",
        "@fastify/multipart": "^10.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "@fastify/session": "^11.1.2",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^6.1.1",
        "@grove/api-contract": "workspace:*",
        "fastify": "^5.12.1",
        "fastify-type-provider-zod": "^7.0.0",
        "openapi-types": "^12.1.3",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/node": "^26.4.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
