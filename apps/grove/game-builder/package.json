{
    "name": "@grove/game-builder",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Compiles a creator's source into the bundle set a session loads.",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo .builds"
    },
    "dependencies": {
        "@grove/api-contract": "workspace:*",
        "@platform/engine": "workspace:*",
        "@platform/project": "workspace:*",
        "@platform/scripting": "workspace:*",
        "@platform/sim": "workspace:*",
        "esbuild": "^0.28.2",
        "fastify": "^5.12.5",
        "fastify-type-provider-zod": "^7.0.0",
        "ioredis": "^6.0.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "vitest": "^4.1.10"
    }
}
