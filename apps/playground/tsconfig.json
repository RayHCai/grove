{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",

        // Vite emits the bundle; `tsc` here is only ever a type check. `composite` is therefore
        // OFF — a composite project may not disable declaration emit (TS6304) — which is also why
        // the root solution tsconfig does not reference this project. See its comment.
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,

        // An app, so it owns a document: `lib` gains DOM, and resolution becomes `bundler`
        // because Vite — not Node — resolves these specifiers, which is also what lets the
        // extensionless `./App` imports below typecheck.
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    // `src/server` is the Node half: decorator syntax, `ws`, and NodeNext resolution. `src/scripts`
    // is the game, and every file in it but `globals.ts` carries decorators. Both belong to
    // `tsconfig.server.json`, and the browser reaches the two scripts it runs as the `dist/scripts`
    // copies `tsc` lowered — decorator syntax through Vite's transform reaches the runtime verbatim.
    //
    // Excluding a directory only drops it from the ROOT file set, so `scripts/globals.ts` is still
    // type-checked here: `project.ts` imports it, and TypeScript follows an import wherever it goes.
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/server", "src/scripts"],
    "references": [
        {
            "path": "../../packages/core"
        },
        {
            "path": "../../packages/math"
        },
        {
            "path": "../../packages/project"
        },
        {
            "path": "../../packages/renderer"
        },
        {
            "path": "../../packages/scripting"
        }
    ]
}
