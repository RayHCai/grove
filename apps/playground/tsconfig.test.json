{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "incremental": false,
        "declaration": false,
        "declarationMap": false,
        "noEmit": true,
        "rootDir": ".",
        // `vite/client` for `import.meta.env`, `node` for the config files this also covers.
        "types": ["vite/client", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "*.config.ts"],
    "references": []
}
