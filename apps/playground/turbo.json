{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": [
                "package.json",
                "src/**",
                "tsconfig*.json",
                "vite.config.ts",
                "index.html",
                "public/**"
            ]
        },
        "typecheck": {
            "inputs": ["src/**", "tests/**", "tsconfig*.json", "*.config.ts"]
        },
        "test": {
            "inputs": ["src/**", "tests/**", "vitest.config.ts", "tsconfig*.json"]
        }
    }
}
