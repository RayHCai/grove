{
    "$schema": "https://turbo.build/schema.json",
    "extends": ["//"],
    "tasks": {
        "build": {
            "inputs": [
                "package.json",
                "src/**",
                "tsconfig.json",
                "tsconfig.server.json",
                "vite.config.ts",
                "index.html",
                "public/**"
            ]
        },
        "typecheck": {
            "inputs": [
                "src/**",
                "tests/**",
                "tsconfig.json",
                "tsconfig.server.json",
                "tsconfig.test.json",
                "*.config.ts"
            ]
        },
        "test": {
            "inputs": ["src/**", "tests/**", "vitest.config.ts", "tsconfig.server.json"]
        }
    }
}
