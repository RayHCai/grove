{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",

        // The Node half, so `module`/`moduleResolution` stay at the base's `NodeNext` rather than
        // taking the browser project's `ESNext`/`bundler` — nothing bundles this, Node resolves it.
        "types": ["node"],

        // `src/server/game.ts` declares the game's scripts, and `tsc` is the only tool here that
        // lowers TC39 standard decorators: Vite's oxc transform emits them verbatim and Node then
        // refuses to parse them. This is why the server half is a separate project at all.
        "lib": ["ES2023", "ESNext.Decorators"],

        // Emitted so `tests/` can import the LOWERED classes and still see their types. `composite`
        // is off because the root solution does not reference this app.
        "composite": false,
        "incremental": false,
        "declaration": true,
        "declarationMap": true
    },
    // `src/synced` and `src/screens` are compiled here too, though the browser runs both: this project
    // is defined by what lowers the decorators, and the browser imports the `dist/` output it emits.
    // `src/project.ts` is here because the server boots from it, and in the browser's project because
    // the client claims the same identity from it — it carries no decorator, so both may read it.
    "include": [
        "src/shared.ts",
        "src/project.ts",
        "src/server/**/*.ts",
        "src/synced/**/*.ts",
        "src/screens/**/*.ts"
    ],
    "references": []
}
