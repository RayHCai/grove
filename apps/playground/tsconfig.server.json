{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",

        // The Node half, so `module`/`moduleResolution` stay at the base's `NodeNext` rather than
        // taking the browser project's `ESNext`/`bundler` — nothing bundles this, Node resolves it.
        "types": ["node"],

        // `src/scripts/` declares the game's scripts, and `tsc` is the only tool here that lowers
        // TC39 standard decorators: Vite's oxc transform emits them verbatim and Node then refuses
        // to parse them. This is why the server half is a separate project at all.
        "lib": ["ES2023", "ESNext.Decorators"],

        // Emitted so `tests/` can import the LOWERED classes and still see their types. `composite`
        // is off because the root solution does not reference this app.
        "composite": false,
        "incremental": false,
        "declaration": true,
        "declarationMap": true
    },
    // The whole game plus the process that hosts it. `src/scripts` is here in its entirety even
    // though the browser runs two of its files: this project is defined by what lowers the
    // decorators, and the browser imports the `dist/scripts/` output it emits.
    //
    // `src/project.ts` and `src/hosting.ts` are in BOTH projects — the server boots from them and
    // the browser claims the same identity and dials the same address. Neither carries a decorator,
    // which is what makes that legal.
    "include": ["src/hosting.ts", "src/project.ts", "src/scripts/**/*.ts", "src/server/**/*.ts"],
    "references": []
}
