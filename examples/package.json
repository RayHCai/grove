{
    "name": "@platform/examples",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Phase-0 sample games, used as regression tests.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@platform/engine": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
