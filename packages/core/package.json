{
    "name": "@platform/core",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Entities, world, behaviors, decorators, dispatcher. No rendering, no network.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "tsc -b && vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@platform/math": "workspace:*",
        "@platform/project": "workspace:*"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
