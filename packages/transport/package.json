{
    "name": "@platform/transport",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Per-connection message pipe: a leaf interface with a loopback implementation; websocket to come.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "peerDependencies": {
        "vitest": "^4.1.10"
    },
    "peerDependenciesMeta": {
        "vitest": {
            "optional": true
        }
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
