{
    "name": "@platform/renderer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "IRenderer interface and the PixiJS implementation.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./pixi": {
            "types": "./dist/pixi/index.d.ts",
            "import": "./dist/pixi/index.js"
        },
        "./null": {
            "types": "./dist/null/index.d.ts",
            "import": "./dist/null/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@platform/math": "workspace:*",
        "pixi.js": "^8.19.0"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
