{
    "name": "@platform/engine",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The creator API a script imports, and the composition roots a host stands a game up with.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./host": {
            "types": "./dist/host/index.d.ts",
            "import": "./dist/host/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@platform/core": "workspace:*",
        "@platform/math": "workspace:*",
        "@platform/project": "workspace:*",
        "@platform/scripting": "workspace:*",
        "@platform/transport": "workspace:*",
        "@platform/sim": "workspace:*",
        "@platform/client": "workspace:*"
    },
    "devDependencies": {
        "@platform/renderer": "workspace:*",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
