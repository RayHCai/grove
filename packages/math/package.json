{
    "name": "@platform/math",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Pure, dependency-free primitives: vectors, bounds, easing, scalar helpers, seeded random, deterministic transcendentals, generation-packed handles, the slot table, typed-array growth.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
