{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "incremental": false,
        "declaration": false,
        "declarationMap": false,
        "noEmit": true,
        "rootDir": ".",
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
    // `@platform/core` is reachable from TESTS ONLY, so the parity checks can pin the restated types
    // against core without core ever reaching the shipped module graph.
    "references": [
        {
            "path": "../../packages/core"
        }
    ]
}
