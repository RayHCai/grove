{
    "name": "@platform/glue",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "The composition of one game: a project in, a running world and the sessions that reach it out.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js"
        },
        "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run --passWithNoTests",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@platform/client": "workspace:*",
        "@platform/core": "workspace:*",
        "@platform/engine": "workspace:*",
        "@platform/project": "workspace:*",
        "@platform/scripting": "workspace:*",
        "@platform/sim": "workspace:*",
        "@platform/transport": "workspace:*",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@platform/math": "workspace:*",
        "@platform/protocol": "workspace:*",
        "@platform/renderer": "workspace:*",
        "@types/node": "^26.4.1",
        "@types/ws": "^8.18.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
