{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "incremental": false,
        "declaration": false,
        "declarationMap": false,
        "noEmit": true,
        "rootDir": ".",
        "types": ["node"],

        // `tests/fixtures/project` is a creator project standing in for a real one, so its scripts
        // carry decorators; the pipeline under test lowers them with its own `tsc` invocation.
        "lib": ["ES2023", "ESNext.Decorators"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
    "references": []
}
