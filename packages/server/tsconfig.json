{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",

        // Only `src/testkit/fixtures.ts` carries decorators, and only because a test needs
        // decorated scripts to dispatch at: `src/` proper declares none (§10). `tsc` lowers
        // standard decorators and the test runner's transform does not, so the fixtures are
        // compiled by the build and imported from `dist` (core DESIGN §3.3, §12).
        "lib": ["ES2023", "ESNext.Decorators"]
    },
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../../packages/core"
        },
        {
            "path": "../../packages/math"
        },
        {
            "path": "../../packages/project"
        },
        {
            "path": "../../packages/protocol"
        },
        {
            "path": "../../packages/transport"
        }
    ]
}
