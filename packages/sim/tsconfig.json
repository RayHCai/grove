{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/.tsbuildinfo",

        // Only `src/testkit/fixtures.ts` carries decorators, and `tsc` lowers them where the test
        // runner's transform does not, so the fixtures are built and imported from `dist`.
        "lib": ["ES2023", "ESNext.Decorators"]
    },
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../../packages/core"
        },
        {
            "path": "../../packages/math"
        },
        {
            "path": "../../packages/project"
        },
        {
            "path": "../../packages/protocol"
        },
        {
            "path": "../../packages/transport"
        }
    ]
}
