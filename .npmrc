strict-peer-dependencies=false
auto-install-peers=true
resolution-mode=highest
# resolution-mode=highest would otherwise take a compromised publish the day it lands.
minimum-release-age=4320
# Turbo runs every task as its own `pnpm run`, and each would otherwise re-resolve the workspace
# and fire a nested install; in parallel those race over `node_modules/.bin` and the git hooks,
# failing whichever task happened to be holding the file.
verify-deps-before-run=false
