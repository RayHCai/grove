# What `compose.yaml` reads. Copy to `.env`; it is gitignored, and compose loads it with no flag.
#
# These are development values in a file everybody can read, which is the whole point: nothing here
# protects anything. A deployed process is handed its own secrets out of band, and the browser apps
# read none of this; they run on the host, and their own `VITE_` values live with them.

# The browser session cookie's key. At least 32 characters.
SESSION_SECRET="dev-session-secret-not-for-anything-real"

# One bearer per pair of services that talk, so no holder can act as a service it is not. At least
# 32 characters each. FLEET_SECRET is the box agents and server-manager alone.
FLEET_SECRET="dev-fleet-secret-not-for-anything-real!"
SERVER_MANAGER_SECRET="dev-server-manager-secret-not-for-anything"
BUILDER_SECRET="dev-builder-secret-not-for-anything-real!"
ASSET_SERVICE_SECRET="dev-asset-service-secret-not-for-anything"

# Ed25519 pairs, each half unpadded base64url of 32 bytes: a signer holds the seed, a verifier the
# public keys (a comma list, so a rotation can add the next before the signer moves to it). The api
# signs join tickets that game-instance verifies; server-manager signs store bearers that
# game-manager verifies. No box holds a signing half.
TICKET_SIGNING_KEY="HpaHMgzw7uPuR3dlmZ6LCEfVgw_bPkKlljA125YI0xY"
TICKET_PUBLIC_KEYS="Pm1_66_VAKaOp5TqGqjjjiENkpZkWl8fFpmEQEyB90w"
STORE_SIGNING_KEY="BOvtBGWJewh5o5WrC2CjEkJJ5H8vnPN1wziQVlW0JHQ"
STORE_PUBLIC_KEYS="2E8RGLWqov0tQMUO84G41ZUVUufPdmdgX3o_sdGlc4E"

POSTGRES_USER="grove"
POSTGRES_PASSWORD="grove"
POSTGRES_DB="grove"

# The bucket the LocalStack init hook makes, with versioning on. Any credential pair reaches it.
GAMES_BUCKET="grove-games"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# The uuid the fleet knows the one local box by. Issued with the box in a deployment, fixed here so a
# recreate is the same box coming back rather than a second one.
LOCAL_HOST_ID="6f1e5a3c-0b2d-4c8e-9a71-2f3b4c5d6e70"

# `1` makes LocalStack log every call it served, which is how a bucket problem is told apart from an
# SDK one.
LOCALSTACK_DEBUG="0"
