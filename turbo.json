{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalDependencies": ["tsconfig.base.json", ".oxlintrc.json"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "tsconfig.json", "package.json"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "tests/**", "tsconfig.json"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "tests/**", "vitest.config.ts"],
            "outputs": []
        },
        "clean": {
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
