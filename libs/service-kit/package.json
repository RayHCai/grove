{
    "name": "@grove/service-kit",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "What every Node service in the fleet starts the same way: the environment parse, the Fastify options, the error shape, the correlation header, and the bearer-carrying call to a peer.",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "grove-dev": "./bin/dev.mjs"
    },
    "files": [
        "dist",
        "bin"
    ],
    "scripts": {
        "build": "tsc -b",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "vitest run",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@grove/api-contract": "workspace:*",
        "fastify": "^5.12.5",
        "fastify-type-provider-zod": "^7.0.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/node": "^24.12.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    }
}
